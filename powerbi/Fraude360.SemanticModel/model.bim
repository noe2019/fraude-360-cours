            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(CheminDonnees & \"fait_typologie_quotidien.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Entetes,{{\"date\", type date}, {\"typologie_fraude\", type text}, {\"cas\", Int64.Type}, {\"detectes\", Int64.Type}, {\"montant\", type number}, {\"score_moyen\", type number}, {\"taux_detection\", type number}}, \"en-US\")",
                "in",
                "    Types"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}