            "expression": "SUM(fait_kpi_quotidien[montant_fraude_subi])",
            "formatString": "#,0 \"$\"",
            "lineageTag": "30b20f89-517c-448a-801e-d8bf182f0199"
          },
          {
            "name": "Pertes totales potentielles",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Exposition brute a la fraude",
            "expression": "[Pertes evitees] + [Pertes subies]",
            "formatString": "#,0 \"$\"",
            "lineageTag": "62514859-02bf-4857-a042-e1991ef6e026"
          },
          {
            "name": "Rappel en dollars",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Part des dollars de fraude effectivement protegee",
            "expression": "DIVIDE([Pertes evitees], [Pertes totales potentielles])",
            "formatString": "0.0 %",
            "lineageTag": "1a3d5480-4a90-4009-b638-401fb177907f"
          },
          {
            "name": "Cout des revues",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Cout operationnel du traitement des alertes",
            "expression": "SUM(fait_kpi_quotidien[cout_revues_manuelles])",
            "formatString": "#,0 \"$\"",
            "lineageTag": "5934ad7e-f19a-4d3d-8d1f-4f13cd471e8a"
          },
          {
            "name": "Cout total",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Pertes subies + cout des revues manuelles",
            "expression": "SUM(fait_kpi_quotidien[cout_total])",
            "formatString": "#,0 \"$\"",
            "lineageTag": "9b11a06c-da05-43f2-9c0c-f524d701fd00"
          },
          {
            "name": "Cout pour 1000 transactions",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Indicateur de pilotage normalise par le volume",
            "expression": "DIVIDE([Cout total], [Nb transactions]) * 1000",
            "formatString": "#,0.00 \"$\"",
            "lineageTag": "08fb82b7-a92c-4545-8203-9c742a1b61f6"
          },
          {
            "name": "Pertes evitees 7 jours",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Dollars proteges sur les sept derniers jours",
            "expression": "CALCULATE([Pertes evitees], DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -7, DAY))",
            "formatString": "#,0 \"$\"",
            "lineageTag": "f3922c21-f65f-4c20-932f-7e294ba5307e"
          },
          {
            "name": "Taux de detection 7 jours",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Rappel glissant : le signal a surveiller au quotidien",
            "expression": "CALCULATE([Taux de detection], DATESINPERIOD(dim_date[date], MAX(dim_date[date]), -7, DAY))",
            "formatString": "0.0 %",
            "lineageTag": "2e758536-d7a9-4127-aed7-5a2e0631736e"
          },
          {
            "name": "Variation du taux d'alerte",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":false}"
              }
            ],
            "description": "Evolution de la charge d'alertes par rapport a la semaine precedente",
            "expression": [
              "VAR Courant = [Taux d'alerte]",
              "VAR Precedent = CALCULATE([Taux d'alerte], DATEADD(dim_date[date], -7, DAY))",
              "RETURN DIVIDE(Courant - Precedent, Precedent)"
            ],
            "formatString": "+0.0 %;-0.0 %;0 %",
            "lineageTag": "a8b53b27-edb6-49bb-90af-8e523953e2a4"
          }
        ],
        "partitions": [
          {
            "name": "fait_kpi_quotidien",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(CheminDonnees & \"fait_kpi_quotidien.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Entetes,{{\"date\", type date}, {\"transactions\", Int64.Type}, {\"montant_total\", type number}, {\"alertes\", Int64.Type}, {\"blocages\", Int64.Type}, {\"fraudes\", Int64.Type}, {\"score_moyen\", type number}, {\"fraudes_detectees\", Int64.Type}, {\"montant_fraude\", type number}, {\"montant_fraude_evite\", type number}, {\"montant_fraude_subi\", type number}, {\"faux_positifs\", Int64.Type}, {\"cout_revues_manuelles\", type number}, {\"cout_total\", type number}}, \"en-US\")",
                "in",
                "    Types"
              ],
              "type": "m"
            }
          }
        ]
      },
